# Leafy Merchant Demo (Espresso Works Ltd) — environment. Autonomous Next.js app, NO database.
# All merchant vars use the PSP_MERCHANT_ prefix.
#
# NOTE: this file is named `env.example` (no leading dot) because the sandbox blocks writing
# dotfiles named `.env*`. Copy it to `.env.local` for local dev:  cp env.example .env.local

# This app's public base URL. Local dev = 8082; container listens on 8080 (host maps 8082:8080).
PSP_MERCHANT_BASE_URL=http://localhost:8082
PSP_MERCHANT_PORT=8082

# The BUSINESS API (backend, host port 8081). Payments, beneficiaries, transfers. None of it moved.
PSP_MERCHANT_PSP_BASE_URL=http://localhost:8081

# The ISSUER (GIAM, host port 8085): discovery, token, introspection. Repointing this one variable
# changes who authenticates, without touching a single business endpoint above.
PSP_MERCHANT_ISSUER_URL=http://localhost:8085/realms/leafypay

# Browser-facing sign-in, at the GIAM console (host port 8086). Credentials are entered there and
# nowhere else, which is the whole point of the separation.
PSP_MERCHANT_AUTHORIZE_URL=http://localhost:8086/auth/login

# LeafyPay's own browser-facing pages. These five were previously DERIVED from the authorize URL by
# string replacement; now that sign-in lives at the authority, deriving them would send four links to
# a host that does not serve them. They follow the application front end and can each be overridden.
PSP_MERCHANT_APP_FRONTEND_URL=http://localhost:8080
# PSP_MERCHANT_LOGOUT_URL=http://localhost:8080/auth/logout
# PSP_MERCHANT_PORTAL_URL=http://localhost:8080
# PSP_MERCHANT_DASHBOARD_URL=http://localhost:8080/system
# PSP_MERCHANT_SIMULATOR_URL=http://localhost:8080/simulator
# PSP_MERCHANT_CREDENTIALS_URL=http://localhost:8080/system/profile/credentials

# Seeded OAuth client for Espresso Works (DEMO creds, from backend/data/merchants.json seeder).
# The SAME confidential client is used for BOTH the user SSO (authorization_code + PKCE) and the
# server-to-server API payment (client_credentials, scope write:payments). Secret is server-only.
PSP_MERCHANT_OAUTH_CLIENT_ID=oauth001-0000-4000-8000-000000000001
# REQUIRED, and deliberately not written down here. The authority derives this client's secret from
# its id, so read the value with:
#     npm run clients:credentials --prefix backend (in the sec-giam repository)
# Left unset, this application authenticates as nobody and the authority declines the flow with
# invalid_client, which is the correct outcome for an unconfigured merchant.
PSP_MERCHANT_OAUTH_CLIENT_SECRET=

# Optional: override the OAuth redirect URI (defaults to <BASE_URL>/api/auth/callback).
# Must match one of the seeded oauthRedirectUris.
# PSP_MERCHANT_REDIRECT_URI=http://localhost:8082/api/auth/callback

# 32+ char secret to encrypt the stateless httpOnly session cookie (AES-256-GCM).
# Generate: openssl rand -base64 32
PSP_MERCHANT_SESSION_SECRET=change-me-to-a-32-byte-random-secret-value
