# Shared workspace packages are COPIED into node_modules, not symlinked.
# Next's Turbopack root is this directory (see next.config.js), and it cannot resolve a module whose
# real path sits outside that root, which is what a `file:` symlink into ../packages is. Copying
# keeps the dependency inside the root like any other. Rebuild a shared package, then reinstall here
# for the change to land.
install-links=true
