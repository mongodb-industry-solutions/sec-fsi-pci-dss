{
  "name": "fsi-psp-leafy-pay",
  "description": "Leafy Pay is a PCI DSS-aligned Payment Service Provider (PSP) platform designed to provide digital banks and card issuers with secure and efficient payment processing capabilities, built on MongoDB.",
  "version": "2.0.7",
  "private": true,
  "scripts": {
    "setup": "npm install && npm install --prefix frontend && npm install --prefix backend && npm install --prefix merchant",
    "setup:key:master": "npm run setup:key:master --prefix backend",
    "setup:key:rsa": "npm run setup:key:rsa --prefix backend",
    "setup:db": "npm run setup:db --prefix backend",
    "setup:db:drop": "npm run setup:db:drop --prefix backend",
    "setup:check": "npm run setup:check --prefix backend",
    "setup:generate": "npm run generate:data --prefix backend",
    "setup:seed": "npm run seed --prefix backend",
    "setup:integrity-issues": "npm run setup:integrity-issues --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:merchant\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:merchant": "npm run dev --prefix merchant",
    "build": "npm run build --prefix frontend && npm run build --prefix backend && npm run build --prefix merchant",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:merchant": "npm run build --prefix merchant",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run test/backend/unit test/frontend/unit",
    "test:integration": "vitest run test/backend/integration test/frontend/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:watch": "vitest watch",
    "deploy": "npm run deploy:kube",
    "deploy:docker": "docker compose up --build",
    "deploy:kube": "tsx tools/kube.ts",
    "type-check": "tsc --noEmit --project backend/tsconfig.json && tsc --noEmit --project frontend/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
