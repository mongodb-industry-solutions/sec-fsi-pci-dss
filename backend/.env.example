# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pci_dss_demo

# Server
# PORT: defaults to 8081 in code; Dockerfile sets 8080 for K8s compatibility
# PORT=8081
NODE_ENV=development

# PSP Platform URLs
PSP_URL_FRONTEND=http://localhost:8080
PSP_CORS_ORIGIN=http://localhost:8080

# JWT
PSP_JWT_SECRET=change-me-in-production
PSP_JWT_EXPIRES_IN=8h

# Admin seed credentials (used during data seeding only)
PSP_ADM_USER=admin@demo.com
PSP_ADM_PASS=demo1234

# Queryable Encryption key management
# KMS_PROVIDER: "local" (dev) | "aws" (prod)
KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=
MONGODB_CRYPT_SHARED_LIB_PATH=/path/to/mongo_crypt_shared_v1.so

# AWS KMS (required when KMS_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_CMK_ARN=arn:aws:kms:us-east-1:123456789:key/your-key-id

# Atlas API (used by integration hub SD-193, optional)
ATLAS_PROJECT_ID=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# Fraud / risk scoring
PSP_FRAUD_AMOUNT_THRESHOLD=500
PSP_RISK_MCC_LIST=7995,6011,6051

# Seed data directory (used by seeding scripts)
PSP_SEED_DATA_DIR=./data

# Project root override (Docker sets /app; leave blank for local dev)
# PSP_PROJECT_ROOT=
