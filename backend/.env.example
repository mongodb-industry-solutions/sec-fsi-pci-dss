# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pci_dss_demo

# Server
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development

# Frontend (used for CORS and redirect URL construction)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Admin seed credentials (used during data seeding only)
ADM_USER=admin@demo.com
ADM_PASS=demo1234

# Queryable Encryption key management
# KMS_PROVIDER: "local" (dev) | "aws" (prod)
KMS_PROVIDER=local
LOCAL_MASTER_KEY_BASE=./keys
MONGODB_CRYPT_SHARED_LIB_PATH=/path/to/mongo_crypt_shared_v1.so

# AWS KMS (required when KMS_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_CMK_ARN=arn:aws:kms:us-east-1:123456789:key/your-key-id

# Atlas API (used by integration hub SD-193, optional)
ATLAS_PROJECT_ID=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_DB_USER_LEVEL=readWrite
MONGODB_URI_LEVEL=

# Fraud / risk scoring
FRAUD_AMOUNT_THRESHOLD=500
RISK_MCC_LIST=7995,6011,6051

# Seed data directory (used by seeding scripts)
SEED_DATA_DIR=./data
