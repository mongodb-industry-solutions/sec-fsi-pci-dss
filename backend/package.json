{
  "name": "fsi-pci-dss-backend",
  "version": "2.7.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch bin/server.ts",
    "build": "tsc",
    "start": "node dist/bin/server.js",
    "setup:db": "ts-node bin/setup.ts",
    "setup:db:drop": "ts-node bin/setup-drop.ts",
    "setup:check": "ts-node bin/validate.ts",
    "setup:key:rsa": "ts-node bin/setup-oauth-keys.ts",
    "seed": "ts-node bin/seed.ts",
    "setup:seed": "ts-node bin/seed.ts",
    "setup:key:master": "ts-node bin/seed-generate-key.ts",
    "setup:integrity-issues": "ts-node bin/seed-integrity-issues.ts",
    "generate:data": "ts-node bin/seed-generate.ts",
    "setup:generate": "ts-node bin/seed-generate.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=unit",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.3",
    "fastify-plugin": "^5.1.0",
    "fsi-pci-dss-demo": "file:..",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongodb-client-encryption": "^7.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.1.2",
    "@types/uuid": "^11.0.0",
    "@types/webidl-conversions": "^7.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
