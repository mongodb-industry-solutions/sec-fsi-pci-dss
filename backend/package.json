    "dotenv": "^16.4.5",
    "fastify": "^5.8.3",
    "fastify-plugin": "^5.1.0",
    "fsi-pci-dss-demo": "file:..",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.5.0",
    "mongodb-client-encryption": "^6.0.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/ms": "^2.1.0",
    "@types/node": "^20.12.7",
    "@types/uuid": "^10.0.0",
    "@types/webidl-conversions": "^7.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5"
  }
