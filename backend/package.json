  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "setup:db": "ts-node bin/setup.ts",
    "setup:db:drop": "ts-node bin/drop.ts",
    "seed": "ts-node bin/seed.ts",
    "generate:key": "ts-node bin/generate-key.ts",
    "generate:data": "ts-node data/generate.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=unit",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
