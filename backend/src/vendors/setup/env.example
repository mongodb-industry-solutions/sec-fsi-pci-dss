# ============================================================
# PCI DSS IST Demo — Environment Variables
# Copy this file to the project root as .env and fill in values.
# ============================================================

# ── MongoDB connection ────────────────────────────────────────────────────────
# Primary connection string (admin / setup operations)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# v2 role-pool architecture: one connection string per QE tier.
# Set these after running `npm run setup:db` (which creates the Atlas DB users).
# Both fall back to MONGODB_URI when not set (offline / local demo mode).
MONGODB_URI_LEVEL1=mongodb+srv://<l1-user>:<l1-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI_LEVEL2=mongodb+srv://<l2-user>:<l2-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=pcidb

# ── KMS / Queryable Encryption ───────────────────────────────────────────────
# Use 'local' for offline demo (CSFLE local key), 'aws' for production.
KMS_PROVIDER=local

# Local KMS: 96-byte hex master key (generated by `npm run setup:key`)
LOCAL_MASTER_KEY=

# AWS KMS (production only — set KMS_PROVIDER=aws)
AWS_KMS_KEY_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Path to the MongoDB Crypt Shared Library (mongocryptd replacement)
# Download from: https://www.mongodb.com/try/download/crypt-shared
CRYPT_SHARED_LIB_PATH=

# ── Atlas Admin API (v2 setup automation) ────────────────────────────────────
# Used by `npm run setup:db` to create Atlas custom roles + DB users automatically.
# Generate an API key in Atlas → Access Manager → API Keys.
# Leave blank to skip; roles must then be created manually in Atlas UI.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=

# v2 DB users created by setup (must match usernames in MONGODB_URI_LEVEL1/2)
ATLAS_DB_USER_LEVEL1=pci_l1
ATLAS_DB_USER_LEVEL1_PASSWORD=<strong-password>
ATLAS_DB_USER_LEVEL2=pci_l2
ATLAS_DB_USER_LEVEL2_PASSWORD=<strong-password>

# ── Application ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# JWT for session tokens
JWT_SECRET=<random-32-char-string>

# Fraud detection thresholds
FRAUD_AMOUNT_THRESHOLD=500
RISK_MCC_LIST=5812,6011,7995

# Escalation token TTL (seconds)
ESCALATION_TOKEN_TTL_SECONDS=3600
