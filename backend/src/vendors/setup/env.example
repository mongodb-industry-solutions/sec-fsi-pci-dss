# ============================================================
# PCI DSS IST Demo - Environment Variables
# Copy this file to the project root as .env and fill in values.
#
# Prefix rules:
#   No prefix  — standard globals (PORT, HOST, NODE_ENV) and external-system vars
#                (MONGODB_*, ATLAS_*, AWS_CMK_ARN, AWS_REGION, AWS_ACCESS_KEY_ID,
#                 AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN)
#   PSP_       — all other app-specific vars (KMS, KAFKA, RABBITMQ, OAUTH, JWT, etc.)
# ============================================================

# ── MongoDB connection ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# v2 role-pool architecture: one connection string per QE tier.
# Both fall back to MONGODB_URI when not set.
MONGODB_URI_LEVEL1=mongodb+srv://<l1-user>:<l1-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI_LEVEL2=mongodb+srv://<l2-user>:<l2-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=pcidb

# ── KMS / Queryable Encryption ───────────────────────────────────────────────
# Use 'local' for offline demo (CSFLE local key), 'aws' for production.
PSP_KMS_PROVIDER=local

# Local KMS: 96-byte base64 master key (generated by npm run setup:key:master)
PSP_KMS_LOCAL_MASTER_KEY=

# Blind index key for phone uniqueness (keyed HMAC). Optional: if unset, a subkey is
# derived from PSP_KMS_LOCAL_MASTER_KEY via HKDF. Set explicitly (>=32 random bytes) to
# decouple it from the QE master key. Changing it invalidates existing digests (re-seed).
PSP_BLIND_INDEX_KEY=

# AWS KMS (production only, set PSP_KMS_PROVIDER=aws)
# AWS SDK credentials use standard env vars (no PSP_ prefix):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CMK_ARN=
AWS_REGION=us-east-1

# Key vault location (defaults shown; override only if non-standard)
PSP_KMS_KEY_VAULT_URI=
PSP_KMS_KEY_VAULT_DATABASE=encryption
PSP_KMS_KEY_VAULT_COLLECTION=__keyVault

# Path to the MongoDB Crypt Shared Library (mongocryptd replacement)
# Download from: https://www.mongodb.com/try/download/crypt-shared
MONGODB_CRYPT_SHARED_LIB_PATH=

# ── Atlas Admin API (v2 setup automation) ────────────────────────────────────
# Used by npm run setup:db to create Atlas custom roles + DB users automatically.
# Generate an API key in Atlas -> Access Manager -> API Keys.
# Leave blank to skip; roles must then be created manually in Atlas UI.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=

# v2 DB users created by setup (must match usernames in MONGODB_URI_LEVEL1/2)
ATLAS_DB_USER_LEVEL1=pci_l1
ATLAS_DB_USER_LEVEL1_PASSWORD=<strong-password>
ATLAS_DB_USER_LEVEL2=pci_l2
ATLAS_DB_USER_LEVEL2_PASSWORD=<strong-password>

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8081
NODE_ENV=development

# ── Application ──────────────────────────────────────────────────────────────
# Base URL the PSP resolves its own internal endpoints against.
PSP_BASE_URL=http://127.0.0.1:8081
PSP_URL_FRONTEND=http://localhost:3000

# CORS allowed origins (comma-separated list, or * for all)
PSP_CORS_ORIGIN=http://localhost:3000

# JWT for internal PSP session tokens (HS256)
PSP_JWT_SECRET=<random-32-char-string>
PSP_JWT_EXPIRES_IN=24h

# Admin credentials for the /api/v1/admin endpoints
PSP_ADM_USER=admin
PSP_ADM_PASS=

# ── Demo exposure switches ───────────────────────────────────────────────────
# The "What does Atlas see?" raw-ciphertext view bypasses QE auto-decryption. Enabled by default in
# every environment; set to false to harden the deployment (mandatory with real cardholder data).
PSP_DEMO_RAW_DOCUMENTS=true
# Re-enables /api/v1/admin/exec under NODE_ENV=production (arbitrary commands; demo only).
PSP_ADMIN_ENFORCE=false

# ── Fraud detection ───────────────────────────────────────────────────────────
PSP_FRAUD_AMOUNT_THRESHOLD=500
PSP_RISK_MCC_LIST=5812,6011,7995

# ── Event bus engine ─────────────────────────────────────────────────────────
# Selects the EventBus transport (Strategy). Options: in-process, kafka, rabbitmq
PSP_EVENT_BUS_ENGINE=in-process
# Topic/exchange prefix for the single domain-event log
PSP_EVENT_BUS_TOPIC_PREFIX=pci.psp

# Kafka (PSP_EVENT_BUS_ENGINE=kafka)
PSP_KAFKA_BROKERS=localhost:9092
PSP_KAFKA_CLIENT_ID=pci-psp
PSP_KAFKA_SSL=false
# Optional SASL (all three required to enable):
PSP_KAFKA_SASL_MECHANISM=
PSP_KAFKA_SASL_USERNAME=
PSP_KAFKA_SASL_PASSWORD=

# RabbitMQ (PSP_EVENT_BUS_ENGINE=rabbitmq)
PSP_RABBITMQ_URL=amqp://localhost

# ── OAuth 2.0 / OIDC (v16) ───────────────────────────────────────────────────
# Key provider for RS256 JWT signing. Options: local, aws
PSP_OAUTH_KEY_PROVIDER=local

# Directory for the RSA private key (PSP_OAUTH_KEY_PROVIDER=local)
PSP_OAUTH_KEY_STORE_DIR=./keys

# AWS KMS Asymmetric CMK for JWT signing (PSP_OAUTH_KEY_PROVIDER=aws)
PSP_OAUTH_AWS_KEY_ARN=
PSP_OAUTH_AWS_REGION=us-east-1

# ── Seed ─────────────────────────────────────────────────────────────────────
# Override the data directory for seed files (defaults to ./data)
PSP_SEED_DATA_DIR=
